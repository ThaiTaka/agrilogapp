# Địa chỉ FastAPI. KHÔNG có tiền tố NEXT_PUBLIC_ — biến này chỉ được đọc ở
# phía máy chủ Next.js, nên nó không bao giờ lọt vào bundle gửi cho trình duyệt.
# Trình duyệt không hề gọi thẳng FastAPI: mọi request đều đi qua Next.js.
API_BASE_URL=http://localhost:8000

# Bật lên khi chạy sau HTTPS (production). Cookie phiên sẽ được gắn cờ `secure`.
# Để trống khi chạy http://localhost, vì cookie `secure` không gửi qua HTTP và
# đăng nhập sẽ im lặng không hoạt động.
# COOKIE_SECURE=1
