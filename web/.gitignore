# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
# ...trừ file mẫu. Nó không chứa bí mật nào, và thiếu nó thì người tiếp theo
# clone repo về không có cách nào biết dự án cần biến môi trường gì.
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
