# ═══════════════════════════════════════════════════════════════════════════
#  AgriLog backend configuration
#  Copy to `.env` and fill in real values:  Copy-Item .env.example .env
#  `.env` is git-ignored. NEVER commit real secrets.
# ═══════════════════════════════════════════════════════════════════════════

APP_ENV=development
LOG_LEVEL=INFO

# ─── Database ──────────────────────────────────────────────────────────────
# Driver is psycopg 3 -> the URL scheme must be `postgresql+psycopg://`
# (NOT `postgresql://`, which resolves to psycopg2 and will fail to import).
DATABASE_URL=postgresql+psycopg://postgres:CHANGE_ME@localhost:5432/agrilog
TEST_DATABASE_URL=postgresql+psycopg://postgres:CHANGE_ME@localhost:5432/agrilog_test

SQL_ECHO=false

# ─── JWT ───────────────────────────────────────────────────────────────────
# Generate a real secret:
#   python -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SECRET=CHANGE_ME_generate_a_long_random_string
JWT_ALGORITHM=HS256

# 7 days. Deliberately long: a farmer may be offline for a week, and forcing a
# re-login before a sync is even possible would defeat the premise of the app.
ACCESS_TOKEN_EXPIRE_MINUTES=10080
# 90 days.
REFRESH_TOKEN_EXPIRE_DAYS=90

# ─── CORS ──────────────────────────────────────────────────────────────────
# Comma-separated. 8081 = Metro bundler, 19006 = Expo web (future web build).
CORS_ORIGINS=http://localhost:8081,http://localhost:19006,http://10.0.2.2:8081

# ─── Sync engine ───────────────────────────────────────────────────────────
# Reject-and-clamp window for device clock skew, in milliseconds (5 minutes).
# See Data_Requirements_Database.md section 6.4.
SYNC_CLOCK_SKEW_TOLERANCE_MS=300000
# Hard ceiling on records in a single push batch (Issue #39 load testing).
SYNC_MAX_BATCH_RECORDS=5000
